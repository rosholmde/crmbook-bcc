<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="MailApp">
  <Id>affaa746-2368-49f8-a2d8-d9c3dbbac043</Id>
  <Version>1.0.0.1</Version><ProviderName>CRMbook BCC</ProviderName><DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="CRMbook BCC"/><Description DefaultValue="Add your CRMbook address to BCC with one click."/>
  <IconUrl DefaultValue="https://rosholmde.github.io/crmbook-bcc/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://rosholmde.github.io/crmbook-bcc/icon-128.png"/>
  <Hosts><Host Name="Mailbox"/></Hosts>
  <Requirements><Sets><Set Name="Mailbox" MinVersion="1.3"/></Sets></Requirements>
  <FormSettings><Form xsi:type="ItemEdit"><DesktopSettings><SourceLocation DefaultValue="https://rosholmde.github.io/crmbook-bcc/commands.html"/></DesktopSettings></Form></FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements><bt:Sets DefaultMinVersion="1.3"><bt:Set Name="Mailbox"/></bt:Sets></Requirements>
    <Hosts><Host xsi:type="MailHost"><DesktopFormFactor>
      <FunctionFile resid="Commands.Url"/>
      <ExtensionPoint xsi:type="MessageComposeCommandSurface"><OfficeTab id="TabDefault"><Group id="CRMbook.Group">
        <Label resid="Group.Label"/>
        <Control xsi:type="Button" id="CRMbook.AddBcc"><Label resid="Button.Label"/>
          <Supertip><Title resid="Button.Label"/><Description resid="Button.Description"/></Supertip>
          <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon><Action xsi:type="ExecuteFunction"><FunctionName>addCrmBcc</FunctionName></Action>
        </Control>
      </Group></OfficeTab></ExtensionPoint>
    </DesktopFormFactor></Host></Hosts>
    <Resources>
      <bt:Images><bt:Image id="Icon.16" DefaultValue="https://rosholmde.github.io/crmbook-bcc/icon-16.png"/><bt:Image id="Icon.32" DefaultValue="https://rosholmde.github.io/crmbook-bcc/icon-32.png"/><bt:Image id="Icon.80" DefaultValue="https://rosholmde.github.io/crmbook-bcc/icon-80.png"/></bt:Images>
      <bt:Urls><bt:Url id="Commands.Url" DefaultValue="https://rosholmde.github.io/crmbook-bcc/commands.html"/></bt:Urls>
      <bt:ShortStrings><bt:String id="Group.Label" DefaultValue="CRMbook"/><bt:String id="Button.Label" DefaultValue="Add CRM BCC"/></bt:ShortStrings>
      <bt:LongStrings><bt:String id="Button.Description" DefaultValue="Add the CRMbook sync address to BCC on this message."/></bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
